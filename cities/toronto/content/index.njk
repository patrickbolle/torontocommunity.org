---
layout: false
permalink: /
---
{%- set totalGroups = 0 %}
{%- set totalListings = 0 %}
{%- for cat in collections.categories %}
  {%- set totalGroups = totalGroups + cat.data.groupCount %}
  {%- set totalListings = totalListings + cat.data.listingCount %}
{%- endfor %}
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/head.njk" %}
  <link rel="stylesheet" href="/_build/home.css">
  <title>Toronto Community: {{ totalGroups }}+ Clubs, Groups & Meetups ({% buildYear %})</title>
  <meta name="description" content="{{ site.description }}">
  <meta property="og:title" content="Toronto Community Directory. Find Your People">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Toronto Community Directory. Find Your People">
  <meta name="twitter:description" content="{{ site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">
  <link rel="canonical" href="{{ site.url }}/">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.title }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "areaServed": {
      "@type": "City",
      "name": "Toronto",
      "address": { "@type": "PostalAddress", "addressRegion": "ON", "addressCountry": "CA" }
    },
    "publisher": { "@type": "Person", "name": "Patrick Bollenbach", "url": "https://bollenbach.ca" }
  }
  </script>
</head>
<body class="homepage">
<a href="#main-content" class="skip-link">Skip to content</a>

{% include "partials/topbar.njk" %}

<main class="container" id="main-content">
  <section class="hero">
    <div class="hero-main">
      <h1>find your people<br>in toronto.</h1>
      <p>Find run clubs, book groups, maker spaces, neighbourhood meetups, and more. Real communities, all in one place.</p>
      <form class="search" role="search" id="homepage-search-form" action="/" method="get">
        <label for="homepage-group-search" class="visually-hidden">Search the directory</label>
        <input type="search" id="homepage-group-search" name="q" aria-label="Search communities" placeholder="search groups: hiking, chess, book clubs…" autocomplete="off" data-umami-event="homepage-search">
        <button type="submit">search</button>
      </form>
      <div class="popular">popular:
        <a href="/run-clubs/">run clubs</a>
        <a href="/book-clubs/">book clubs</a>
        <a href="/dinner-supper-clubs/">supper clubs</a>
        <a href="/hiking-outdoors/">hiking</a>
        <a href="/chess/">chess</a>
      </div>
    </div>
    <aside class="hero-profile">
      <p class="hero-profile-name">Patrick</p>
      <p class="hero-profile-line">I keep this list. New groups added weekly.</p>
      <p class="hero-profile-links"><a href="/about/">about the directory</a></p>
    </aside>
  </section>

  <div id="search-results" class="search-results" hidden></div>

  <section class="section home-content">
    <div>
      <h2 class="section-title">browse the directory</h2>
      <div class="directory-grid">
        {%- for group in groups %}
        {%- set sectionCats = collections.categories | sectionCategories(group.key) %}
        <section class="category">
          {%- set sectionTotal = 0 %}
          {%- for cat in sectionCats %}{% set sectionTotal = sectionTotal + cat.data.listingCount %}{% endfor %}
          <h3>{{ group.label }} <span>({{ sectionTotal }})</span></h3>
          <ul>
            {%- for cat in sectionCats.slice(0, 5) %}
            <li><a href="/{{ cat.fileSlug }}/">{{ cat.data.title }}</a>{% if cat.data.listingCount > 0 %} <span class="count">({{ cat.data.listingCount }})</span>{% endif %}</li>
            {%- endfor %}
          </ul>
          {%- if sectionCats.length > 5 %}
          <details class="directory-more">
            <summary><span class="directory-more-closed">+{{ sectionCats.length - 5 }} more</span><span class="directory-more-open">fewer</span></summary>
            <ul>
              {%- for cat in sectionCats.slice(5) %}
              <li><a href="/{{ cat.fileSlug }}/">{{ cat.data.title }}</a>{% if cat.data.listingCount > 0 %} <span class="count">({{ cat.data.listingCount }})</span>{% endif %}</li>
              {%- endfor %}
            </ul>
          </details>
          {%- endif %}
        </section>
        {%- endfor %}
      </div>
    </div>

    <aside class="sidebar">
      <div class="sidebar-block">
        <h3>new to toronto?</h3>
        <p>A short, practical guide to finding people and communities in the city.</p>
        <a href="/start-here/">read the guide →</a>
      </div>
      <div class="sidebar-block">
        <h3>useful guides</h3>
        <ul>
          <li><a href="/blog/how-to-make-friends-in-toronto/">How to make friends in Toronto</a></li>
          <li><a href="/blog/best-book-clubs-in-toronto/">The best book clubs</a></li>
          <li><a href="/blog/things-to-do-alone-in-toronto/">Things to do alone</a></li>
          <li><a href="/blog/writing-groups-in-toronto/">Writing groups</a></li>
        </ul>
      </div>
      <div class="sidebar-block hp-newsletter">
        <h3>the toronto roundup</h3>
        <p>New groups and community picks, weekly.</p>
        <form class="newsletter-form subscribe" data-umami-event="newsletter-signup">
          <input type="email" class="newsletter-input" placeholder="your@email.com" required autocomplete="email" aria-label="Email address">
          <button type="submit" class="newsletter-btn">join</button>
        </form>
        <p class="newsletter-status" role="status" aria-live="polite"></p>
      </div>
    </aside>
  </section>

  <section class="section just-added">
    <div class="just-added-head">
      <h2 class="section-title">just added</h2>
      <a class="just-added-cta" href="/submit/">suggest a group →</a>
    </div>
    <div class="just-added-grid">
      {%- for g in recentGroups.slice(0, 4) %}
      <div class="ja-item">
        <a class="ja-cat" href="/{{ g.categorySlug }}/">{{ g.categoryTitle }}</a>
        <a class="ja-name" href="{{ g.url }}" target="_blank" rel="noopener noreferrer">{{ g.name }} →</a>
        <span class="ja-desc">{{ g.description | truncate(80) }}</span>
      </div>
      {%- endfor %}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">explore by neighbourhood</h2>
    <div class="neighbourhood-list">
      {%- for hood in neighbourhoods %}
      {%- set ng = collections.categories | neighbourhoodGroups(hood.aliases) %}
      {%- set hoodTotal = 0 %}
      {%- for c in ng %}{% set hoodTotal = hoodTotal + c.groups.length %}{% endfor %}
      <div class="neighbourhood-row"><a href="/neighbourhoods/{{ hood.slug }}/">{{ hood.name }}</a> <span class="count">({{ hoodTotal }})</span></div>
      {%- endfor %}
    </div>
    <p class="neighbourhood-all"><a href="/neighbourhoods/">all neighbourhoods →</a></p>
  </section>

  <section class="section note-band">
    <p class="note-text">Toronto can feel like a hard city to make friends. I built this directory as a shortcut, a list of places where people actually show up, week after week.</p>
    <p class="note-sign">By Patrick. <a href="/about/">About the directory</a></p>
  </section>
</main>

{% include "partials/footer.njk" %}

<script>
var _searchGroups = [
{%- for cat in collections.categories -%}
  {%- for item in (cat.data.allGroupItems or cat.data.groupItems) -%}
  {n:"{{ item.name | replace('"', '\\"') | safe }}",d:"{{ item.description | replace('"', '\\"') | truncate(120) | safe }}",c:"{{ cat.data.title | safe }}",s:"{{ cat.fileSlug }}",id:"{{ item.name | mdAnchor }}",u:"{{ item.url | safe }}",w:"{{ item.location | replace('"', '\\"') | safe }}",b:"{% if item.free %}Free{% endif %}"},
  {%- endfor -%}
{%- endfor -%}
];
</script>
{% include "partials/scripts.njk" %}
</body>
</html>
