{%- set mastheadGroups = 0 %}
{%- for cat in collections.categories %}{% set mastheadGroups = mastheadGroups + cat.data.groupCount %}{% endfor %}
{%- set navPath = page.url or "/" %}
{%- set tabMatch = "/" %}
{%- for h in ["/start-here/", "/submit/", "/blog/", "/about/"] %}{% if navPath.indexOf(h) == 0 %}{% set tabMatch = h %}{% endif %}{% endfor %}
<header class="site-header">
  <div class="container">
    <div class="header-top">
      <a class="wordmark" href="/" aria-label="Toronto Community home">toronto community</a>
      <span class="metadata">{{ mastheadGroups }} groups · {{ collections.categories.length }} categories</span>
    </div>
    <nav class="nav" aria-label="Sections">
      <a href="/"{% if tabMatch == "/" %} class="active"{% endif %}>directory</a>
      <a href="/start-here/"{% if tabMatch == "/start-here/" %} class="active"{% endif %}>new to toronto</a>
      <a href="/submit/"{% if tabMatch == "/submit/" %} class="active"{% endif %}>add a group</a>
      <a href="/blog/"{% if tabMatch == "/blog/" %} class="active"{% endif %}>blog</a>
      <a href="/about/"{% if tabMatch == "/about/" %} class="active"{% endif %}>about</a>
    </nav>
  </div>
</header>
