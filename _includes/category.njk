<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/head.njk" %}
  {%- set titleHasGroupWord = "club" in title | lower or "group" in title | lower or "space" in title | lower or "bar" in title | lower -%}
  {%- if groupCount and titleHasGroupWord -%}
    {%- set metaTitle = groupCount + " " + title + " in Toronto" -%}
  {%- elif groupCount -%}
    {%- set metaTitle = groupCount + " " + title + " Group" + ("s" if groupCount != 1) + " in Toronto" -%}
  {%- else -%}
    {%- set metaTitle = title + " in Toronto" -%}
  {%- endif -%}
  {#- Optional front matter overrides, written from Search Console queries:
      seoTitle / seoDescription ({n} = group count, {year} = build year), seoHeading (the h1). -#}
  {%- if seoTitle -%}
    {%- set pageTitle = seoTitle | replace("{n}", listingCount) | replace("{year}", buildYear) -%}
  {%- else -%}
    {%- set pageTitle = metaTitle + " (" + buildYear + ")" -%}
  {%- endif -%}
  {%- set liveDescription = description | replace("{n}", listingCount) | replace("{year}", buildYear) | liveCount(listingCount, groupCount) -%}
  {%- set pageDescription = (seoDescription | replace("{n}", listingCount) | replace("{year}", buildYear)) if seoDescription else liveDescription -%}
  <title>{{ pageTitle }}{% if (pageTitle | length) <= 41 %} | {{ site.shortTitle }}{% endif %}</title>
  <meta name="description" content="{{ pageDescription }} Updated {% buildDateHuman %}.">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/{{ page.fileSlug }}/">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">
  <link rel="canonical" href="{{ site.url }}/{{ page.fileSlug }}/">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "{{ title }} in Toronto",
    "description": "{{ pageDescription | replace('"', '\\"') }}",
    "url": "{{ site.url }}/{{ page.fileSlug }}/",
    {% if groupCount %}"numberOfItems": {{ groupCount }},{% endif %}
    "about": { "@type": "Thing", "name": "{{ title }}" },
    "isPartOf": { "@type": "WebSite", "name": "{{ site.title }}", "url": "{{ site.url }}" }{% if groupItems.length %},
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ groupItems.length }},
      "itemListElement": [
        {%- for item in groupItems %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "item": {
            "@type": "Organization",
            "name": "{{ item.name | replace('"', '\\"') }}"{% if item.description %},
            "description": "{{ item.description | replace('"', '\\"') }}"{% endif %}{% if item.url %},
            "url": "{{ item.url | safe }}"{% endif %}
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }{% endif %}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Toronto Community Directory", "item": "{{ site.url }}/" },
      { "@type": "ListItem", "position": 2, "name": "{{ title }}", "item": "{{ site.url }}/{{ page.fileSlug }}/" }
    ]
  }
  </script>
</head>
<body class="category-page">
<a href="#main-content" class="skip-link">Skip to content</a>
{% include "partials/topbar.njk" %}

<main class="container" id="main-content">
  <section class="section">
    <p class="crumb"><a href="/">directory</a>{% if page.data.groupLabel %} / {{ page.data.groupLabel }}{% endif %}</p>
    <h1 class="category-title">{% if seoHeading %}{{ seoHeading }}{% else %}{{ title }}{% endif %}</h1>
    <p class="category-lede">{{ pageDescription }}</p>
  </section>

  <section class="section detail-columns">
    <div>
      <h2 class="section-title">{{ listNoun or (title ~ " groups") }} <span class="count">({{ listingCount }})</span></h2>
      <ul class="result-list">
        {%- for item in (allGroupItems or groupItems) %}
        <li>
          <span class="tag">{% if item.when %}{{ item.when }}{% endif %}{% if item.location %}{% if item.when %} · {% endif %}{{ item.location }}{% endif %}{% if item.free %}{% if item.when or item.location %} · {% endif %}free{% endif %}</span>
          <p><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" data-umami-event="outbound-link">{{ item.name }} →</a></p>
          <p>{{ item.description }}</p>
        </li>
        {%- endfor %}
      </ul>
    </div>
    <aside class="sidebar">
      <div class="sidebar-block">
        <h3>browse nearby topics</h3>
        <ul>
          {%- for sib in (collections.categories | sectionCategories(page.data.group)) %}
          {%- if sib.fileSlug != page.fileSlug %}
          <li><a href="/{{ sib.fileSlug }}/">{{ sib.data.title }}</a></li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </div>
      <div class="sidebar-block">
        <h3>know a group?</h3>
        <a href="/submit/">suggest a listing →</a>
      </div>
      <div class="sidebar-block hp-newsletter">
        <h3>the toronto roundup</h3>
        <p>New groups and community picks, weekly.</p>
        <form class="newsletter-form subscribe" data-umami-event="newsletter-signup">
          <input type="email" class="newsletter-input" placeholder="your@email.com" required autocomplete="email" aria-label="Email address">
          <button type="submit" class="newsletter-btn">join</button>
        </form>
        <p class="newsletter-status" role="status" aria-live="polite"></p>
      </div>
    </aside>
  </section>
</main>

{% include "partials/footer.njk" %}
<script>
var _searchGroups = [
{%- for cat in collections.categories -%}
  {%- for item in (cat.data.allGroupItems or cat.data.groupItems) -%}
  {n:"{{ item.name | replace('"', '\\"') | safe }}",d:"{{ item.description | replace('"', '\\"') | truncate(120) | safe }}",c:"{{ cat.data.title | safe }}",s:"{{ cat.fileSlug }}",id:"{{ item.name | mdAnchor }}",u:"{{ item.url | safe }}",w:"{{ item.location | replace('"', '\\"') | safe }}",b:"{% if item.free %}Free{% endif %}"},
  {%- endfor -%}
{%- endfor -%}
];
</script>
{% include "partials/scripts.njk" %}
</body>
</html>
